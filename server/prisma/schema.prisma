generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  HOST
  INVITEE
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  RESCHEDULED
}

model User {
  id                    String                 @id @default(uuid())
  name                  String
  email                 String                 @unique
  passwordHash          String
  role                  Role                   @default(HOST)
  username              String                 @unique
  timezone              String                 @default("America/New_York")
  avatarUrl             String?
  bio                   String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  eventTypes            EventType[]
  availabilities        Availability[]
  availabilityOverrides AvailabilityOverride[]
  hostedBookings        Booking[]              @relation("HostBookings")

  @@index([username])
}

model EventType {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  slug            String
  description     String?
  duration        Int            // in minutes (e.g. 15, 30, 60)
  bufferBefore    Int            @default(0) // in minutes
  bufferAfter     Int            @default(0) // in minutes
  price           Float?
  currency        String         @default("USD")
  color           String         @default("#3B82F6")
  isActive        Boolean        @default(true)
  customQuestions String?        // JSON string: array of question objects
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  bookings        Booking[]
  availabilities  Availability[]

  @@unique([userId, slug])
  @@index([userId, slug])
}

model Availability {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventTypeId String?
  eventType   EventType? @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  dayOfWeek   Int        // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime   String     // "HH:mm" 24h format, e.g. "09:00"
  endTime     String     // "HH:mm" 24h format, e.g. "17:00"
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId, dayOfWeek])
}

model AvailabilityOverride {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          String   // "YYYY-MM-DD"
  startTime     String?  // Optional override window
  endTime       String?
  isUnavailable Boolean  @default(false) // true if host takes off the entire day
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, date])
}

model Booking {
  id                 String        @id @default(uuid())
  eventTypeId        String
  eventType          EventType     @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  hostId             String
  host               User          @relation("HostBookings", fields: [hostId], references: [id], onDelete: Cascade)
  inviteeName        String
  inviteeEmail       String
  inviteeTimezone    String        @default("UTC")
  inviteeNotes       String?
  customAnswers      String?       // JSON string of answers
  startTime          DateTime      // UTC timestamp
  endTime            DateTime      // UTC timestamp
  status             BookingStatus @default(CONFIRMED)
  cancellationReason String?
  meetingUrl         String?       // Google Meet / Zoom generated link
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  webhookLogs        WebhookLog[]

  @@index([hostId, startTime, endTime])
  @@index([eventTypeId])
}

model WebhookLog {
  id           String   @id @default(uuid())
  bookingId    String?
  booking      Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  event        String   // "booking.created", "booking.cancelled", "calendar.sync"
  payload      String   // JSON string
  status       String   // "SUCCESS" or "FAILED"
  responseCode Int?
  createdAt    DateTime @default(now())
}
